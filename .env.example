# Required Cloudflare infrastructure credentials.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Telegram bot token from BotFather.
BOT_TOKEN=

# Initial Telegram administrator user IDs.
# Used only when the database has no administrators.
# Example: 123456789,987654321
ADMIN_IDS=

# Use a different name for each independent store.
# Lowercase letters, digits and hyphens.
SHOP_SLUG=my-persian-store-v2

# Optional infrastructure secret.
# Configure the public site key and enable Turnstile from the bot.
TURNSTILE_SECRET_KEY=